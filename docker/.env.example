# Environment variables for QRLight.
#
# This single example file feeds both ways of running the project:
#   * the Docker deployment in docker/docker-compose.yml (block 1)
#   * local development and self-built images, via Vite (block 2)
#
# Copy it where each consumer expects it — never commit the result:
#   cp docker/.env.example docker/.env   # Docker Compose overrides
#   cp docker/.env.example .env          # Vite dev server / local builds
# Both targets are git-ignored.

# ---------------------------------------------------------------------------
# 1. Docker Compose (docker/docker-compose.yml)
#
# Compose loads the .env that sits next to the compose file passed with -f, so
# the copy for this block must live in docker/. Only these variables are read
# by the compose file; everything below them configures the app itself and is
# ignored at container runtime.
# ---------------------------------------------------------------------------

# Image to run. :latest follows the newest vX.Y.Z release; pin an exact
# version for a reproducible deployment.
QRLIGHT_IMAGE=ghcr.io/ivancarlosti/qrlight:latest
# QRLIGHT_IMAGE=ghcr.io/ivancarlosti/qrlight:2.0.1

# Host port published for the app. The container always listens on 8080.
QRLIGHT_PORT=8080

# Name of the container as shown by `docker ps`.
QRLIGHT_CONTAINER_NAME=qrlight

# ---------------------------------------------------------------------------
# 2. Vite (local development and self-built images)
#
# Read by vite.config.js via loadEnv() from a `.env` in the repository root.
# Everything prefixed with VITE_ is inlined into the bundle at BUILD time, so
# an already-built image ignores all of it — including
# ghcr.io/ivancarlosti/qrlight:latest, which is compiled with
# VITE_DEFAULT_PRESET=Plain, VITE_HIDE_CREDITS=true and
# VITE_DISABLE_LOCAL_STORAGE=true (see the Dockerfile).
# ---------------------------------------------------------------------------

# Base path for deployment (e.g. /qrlight for deploying at domain.com/qrlight)
# Default: ./ (relative paths, works at any sub-path without configuration)
BASE_PATH=/qrlight

# Version shown in the footer. Use a vX.Y.Z tag to override the version read from
# public/CHANGELOG.md; anything else falls back to the changelog.
# VITE_APP_VERSION=v1.0.20

VITE_HIDE_CREDITS=false
# Plain is the only bundled design preset and the default for a fresh session.
VITE_DEFAULT_PRESET=Plain
VITE_DEFAULT_DATA_TO_ENCODE=
# JSON array of preset objects. Setting this replaces the built-in list entirely,
# so include a "Plain" entry if you still want it available.
VITE_QR_CODE_PRESETS=
VITE_FRAME_PRESET=
VITE_FRAME_PRESETS=
VITE_DISABLE_LOCAL_STORAGE=false
VITE_ENABLE_ANALYTICS=false

# Show the Simple/Full mode toggle + "Customize fields" button. Off by default
# so self-hosted deployments aren't exposed to it unless opted in. The e2e
# suite forces it on through playwright.config.ts (webServer.env); set it here
# too if you want the toggle while running `pnpm dev` by hand.
VITE_QR_CREATE_SIMPLE_FULL_MODE_TOGGLE=false
# Comma-separated field keys to show. When set, the app starts in Simple mode
# showing only the data field + these fields (e.g. dotsColor,frameText). Leave
# empty for the normal full-config experience.
VITE_FIELDS_VISIBLE=
